{
  "name": "dsh-input-history",
  "version": "0.3.0",
  "description": "Input history switcher for the DSH composer: every submitted prompt (text plus attachment bytes) persists locally — max 50 entries, newest first — and an EMPTY composer recalls it via ArrowUp/ArrowDown, with image thumbnails and file attachments re-attached through the conversation draft pipeline.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "input-history",
    "arrow-key",
    "composer",
    "persistence"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunshaobei/dsh-input-history.git"
  },
  "bugs": {
    "url": "https://github.com/sunshaobei/dsh-input-history/issues"
  },
  "homepage": "https://github.com/sunshaobei/dsh-input-history#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": []
    }
  }
}
