{
  "name": "dsh-input-history",
  "version": "0.2.0",
  "description": "Standalone arrow-key input history for the DSH web composer: every sent prompt (Enter or the send button, in any session or workspace) persists to ONE global ring in ~/.dsh/input-history.json (default 100 entries, overridable) and ↑/↓ recalls it instantly and completely — survives app restarts.",
  "keywords": [
    "dsh",
    "deepseek-harness",
    "plugin",
    "input-history",
    "arrow-key",
    "composer",
    "persistence"
  ],
  "type": "module",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sunshaobei/dsh-input-history.git"
  },
  "bugs": {
    "url": "https://github.com/sunshaobei/dsh-input-history/issues"
  },
  "homepage": "https://github.com/sunshaobei/dsh-input-history#readme",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "engines": {
    "node": ">=20"
  },
  "files": [
    "lib",
    "cordis.patch.yml",
    "README.md"
  ],
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-api-gateway",
        "@deepseek-ai/dsh-client-ui-conversation"
      ]
    }
  }
}
